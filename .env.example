PORT=3001
HOST=0.0.0.0
ROOM_STORAGE=memory
# Voice service configuration (server only).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DATABASE_URL=postgresql://jackaroo:jackaroo@localhost:5432/jackaroo?schema=public
# Community accounts/rooms are stored in PostgreSQL.
# Google and Apple OAuth audiences are comma-separated platform client IDs.
GOOGLE_OAUTH_AUDIENCES=
APPLE_OAUTH_AUDIENCES=
# Configure Resend for production email verification/password resets.
RESEND_API_KEY=
EMAIL_FROM=Jackaroo <accounts@example.com>
PUBLIC_APP_URL=http://localhost:8081
